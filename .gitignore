# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Large / reproducible artefacts (tracked implicitly by manifests).
# Individual small JSONs can still be committed with `git add -f <path>`
# when we want a permanent paper-grade snapshot.
experiments/E*/runs/
experiments/E*/figures/cache/
*.log
*.tmp

# Explicit small artefacts we DO want tracked whenever committed with -f:
# - manifest.json (run provenance)
# - e1_summary.json / *_summary.json (per-experiment headline metrics)
# - agent_vote_tally.json (governance health evidence)
# - best_formula_*.tex (LaTeX headline)
# - pareto_front_*.json
# - discovery_report_*.json

# PySR drops a fresh scratch dir per call at CWD/outputs/ (checkpoints,
# hall_of_fame CSVs). These are large, reproducible from seeds, and
# clutter git diffs. Always relocate into the run dir or delete.
outputs/

# Secrets — never commit
.env
.env.*
**/api_keys*
**/secrets*

# v1 archive (read-only reference; track contents separately if at all)
legacy_v1/outputs_v1/
legacy_v1/results_v1/

# IDE-specific dirs that sometimes appear
.claude/
